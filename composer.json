{
    "name": "stickysoftware/bump-laravel",
    "description": "Laravel client for Bump: send events, keep exact totals.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Wouter Dijkstra",
            "email": "wouter@squaredlemon.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "StickySoftware\\Bump\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StickySoftware\\Bump\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StickySoftware\\Bump\\BumpServiceProvider"
            ],
            "aliases": {
                "Bump": "StickySoftware\\Bump\\Facades\\Bump"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
