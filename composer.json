{
    "name": "stickysoftware/bump-laravel",
    "description": "Laravel client for Bump: send events from your app, and Bump keeps exact running totals.",
    "keywords": [
        "laravel",
        "bump",
        "events",
        "metrics",
        "counters",
        "analytics",
        "milestones"
    ],
    "homepage": "https://bumpbunny.dev",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wouter Dijkstra",
            "email": "hello@bumpbunny.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/stickysoftware/bump-laravel/issues",
        "source": "https://github.com/stickysoftware/bump-laravel",
        "docs": "https://bumpbunny.dev/docs"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.45|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.9|^11.0",
        "pestphp/pest": "^4.0",
        "spatie/laravel-prefixed-ids": "^1.5"
    },
    "suggest": {
        "spatie/laravel-prefixed-ids": "Sends a model's prefixed ID (usr_3f9a…) as its Bump handle."
    },
    "autoload": {
        "psr-4": {
            "StickySoftware\\Bump\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StickySoftware\\Bump\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StickySoftware\\Bump\\BumpServiceProvider"
            ],
            "aliases": {
                "Bump": "StickySoftware\\Bump\\Facades\\Bump"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
